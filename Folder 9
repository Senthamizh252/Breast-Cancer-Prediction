      "source": [
        "### 1. Load and Inspect the Dataset\n",
        "We will use the `pandas` library to load the dataset `Breast-Cancer-Prediction.csv`. We will print the number of rows and columns, view the column names, and display the first five rows of the dataset to understand what features we have."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "81e55197",
        "outputId": "8ade86df-d2ad-400e-fa6f-69e8737900bf"
      },
      "source": [
        "import pandas as pd\n",
        "import os\n",
        "\n",
        "file_path = 'Breast-Cancer-Prediction.csv'\n",
        "\n",
        "try:\n",
        "    # Load the CSV file\n",
        "    df = pd.read_csv(file_path)\n",
        "    print(\"Dataset successfully loaded!\")\n",
        "    print(f\"Number of rows: {df.shape[0]}\")\n",
        "    print(f\"Number of columns: {df.shape[1]}\\n\")\n",
        "\n",
        "    # Display column names\n",
        "    print(\"Column Names:\")\n",
        "    print(df.columns.tolist())\n",
        "    print(\"\\nFirst 5 rows of the dataset:\")\n",
        "    display(df.head())\n",
        "except FileNotFoundError:\n",
        "    print(f\"Error: The file '{file_path}' was not found in the current directory. Please make sure you have uploaded it to Google Colab.\")\n",
        "except Exception as e:\n",
        "    print(f\"An unexpected error occurred while loading the dataset: {e}\")"
